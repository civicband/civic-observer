# CivicObserver environment template.
#
# Copy to `.env` (local development) or `.env.production` (deployment) and
# replace every placeholder. NEVER commit real values — only this template
# and `.env-dist` are tracked by git.

# --- Core ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-me-with-a-long-random-value
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://postgres@db/postgres
REDIS_URL=redis://redis:6379/0

# --- Email (Postmark, via django-anymail) -------------------------------
POSTMARK_SERVER_TOKEN=

# --- Error tracking -----------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
VERSION=

# --- Service-to-service / webhooks --------------------------------------
CORKBOARD_SERVICE_SECRET=
WEBHOOK_SECRET=

# --- Notification channels (optional) -----------------------------------
DISCORD_BOT_TOKEN=
BLUESKY_BOT_HANDLE=
BLUESKY_BOT_PASSWORD=
MASTODON_ACCESS_TOKEN=
MASTODON_INSTANCE_URL=https://mastodon.social

# --- Log shipping (Vector) ----------------------------------------------
VL_ENDPOINT=
VL_USER=
VL_PASSWORD=
HOSTNAME_OVERRIDE=
