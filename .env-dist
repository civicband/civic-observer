# Copy this file to .env and update values as needed
# See `.env.example` for the full set of supported variables.
# For local development with Docker:
ALLOWED_HOSTS=*
DATABASE_URL=postgres://postgres@db/postgres
DJANGO_DEBUG=true
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_PORT=8888

# Required. Development has an insecure fallback, but production refuses to
# start without an explicit value. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# API Key Validation (for corkboard service-to-service auth)
# Generate a secure random string for production
CORKBOARD_SERVICE_SECRET=

# Webhook authentication for municipalities API
WEBHOOK_SECRET=

# Notification Channels (optional)
DISCORD_BOT_TOKEN=
BLUESKY_BOT_HANDLE=
BLUESKY_BOT_PASSWORD=
MASTODON_ACCESS_TOKEN=
MASTODON_INSTANCE_URL=https://mastodon.social
